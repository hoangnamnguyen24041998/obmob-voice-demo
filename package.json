    "expo": "~51.0.0",
    "expo-build-properties": "~0.12.5",
    "expo-dev-client": "~4.0.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-background-timer": "^2.4.1",
    "react-native-get-random-values": "^1.11.0"
  },
  "devDependencies": {
